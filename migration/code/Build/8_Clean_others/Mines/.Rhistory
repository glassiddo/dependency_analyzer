#calculate change in mineral prices during that period
d_price <- price_df %>% filter(year %in% c(yr_start,yr_end)) %>%
mutate(across(!year, ~log(.x)),
across(!year, ~.x - lag(.x))) %>%
drop_na(P_gold_nom) %>%
select(-year) %>%
pivot_longer(cols = everything(),
names_to = "commodity",
values_to = "d_log_p") %>%
mutate(type = ifelse(str_sub(commodity, -3) == "nom", "Nominal", "Real"),
commodity = str_remove(commodity, "P_"),
commodity = str_remove(commodity, "_nom"),
commodity = str_remove(commodity, "_real"),
commodity = str_to_title(commodity),
primary_commodity = case_when(
commodity == "Iron" ~ "Iron Ore",
commodity == "U308" ~ "U3O8",
commodity == "Heavymineralsands" ~ "Heavy Mineral Sands",
TRUE ~commodity
)) %>%
select(-commodity) %>%
pivot_wider(names_from = type,
values_from = d_log_p) %>%
rename(d_log_p_nom = Nominal,
d_log_p_real = Real)
