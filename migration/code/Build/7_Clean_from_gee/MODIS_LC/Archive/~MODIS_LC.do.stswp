global layers " LC_Prop2 LC_Type1  LC_Type2 LC_Type3 LC_Type4 LC_Type5"


foreach layer in $layers {
	import delimited "$projdir\data\Raw\Africa\MODIS_LC/`layer'.csv", clear varnames(1)
	
	if "`layer'"=="LC_Type1" {
		gegen total_`layer'=rowtotal(v2-v8 v10-v16)		
		gegen forest_`layer'=rowtotal(v2 v10-v12)
		gegen crop_`layer'=rowtotal(v5 v7)
		gegen built_`layer'=rowtotal(v6)
	}
	if "`layer'"=="LC_Type2" {
		gegen total_`layer'=rowtotal(v2-v14)		
		gegen forest_`layer'=rowtotal(v2 v3 v8-v10)
		gegen crop_`layer'=rowtotal(v5)
		gegen built_`layer'=rowtotal(v6)
	}
	if "`layer'"=="LC_Type3" {
		gegen total_`layer'=rowtotal(v3-v11)		
		gegen forest_`layer'=rowtotal(v8-v10)
		gegen crop_`layer'=rowtotal(v3 v6)
		gegen built_`layer'=rowtotal(v4)
	}
	if "`layer'"=="LC_Type4" {
		gegen total_`layer'=rowtotal(v3-v9)		
		gegen forest_`layer'=rowtotal(v3-v5)
		gegen crop_`layer'=rowtotal(v7 v6)
		gegen built_`layer'=rowtotal(v9)
	}
	if "`layer'"=="LC_Type5" {
		gegen total_`layer'=rowtotal(v3-v11)		
		gegen forest_`layer'=rowtotal(v3 v5 v6)
		*** v3 = 1 = Evergreen Needleleaf Trees: dominated by evergreen conifer trees (>2m). Tree cover >10%.
		*** v5 = 2 = 	Evergreen Broadleaf Trees: dominated by evergreen broadleaf and palmate trees (>2m). Tree cover >10%.
		*** v6 = 4 = Deciduous Broadleaf Trees: dominated by deciduous broadleaf trees (>2m). Tree cover >10%.
		gegen crop_`layer'=rowtotal(v9 v10)
		*** v9 = 7 = Cereal Croplands: dominated by herbaceous annuals (<2m). At least 60% cultivated cereal crops.
		*** v10 = 8 = Broadleaf Croplands: dominated by herbaceous annuals (<2m). At least 60% cultivated broadleaf crops.
		gegen built_`layer'=rowtotal(v11)
		*** v11 = 9 = Urban and Built-up Lands: at least 30% impervious surface area including building materials, asphalt, and vehicles.
		
		gegen barren_`layer'=rowtotal(v4)
		* v4 = 11 = Non-Vegetated Lands: at least 60% of area is non-vegetated barren (sand, rock, soil) with less than 10% vegetation.
		
		gegen shrub_`layer'=rowtotal(v7)
		* v7 = 5 = 	Shrub: Shrub (1-2m) cover >10%.
		
		gegen grass_`layer'=rowtotal(v8)
		* v8 = 6 = Grass: dominated by herbaceous annuals (<2m) that are not cultivated.
		
	}
	if "`layer'"=="LC_Prop2" {
		gegen total_`layer'=rowtotal(v2-v5 v7-v11)		
		gegen forest_`layer'=rowtotal(v3)
		gegen crop_`layer'=rowtotal(v5 v8 v9)
		gegen built_`layer'=rowtotal(v11)
	}
	gen year=real(substr(systemindex,3,4))
	keep year *`layer' ipums_id
	
	foreach var of varlist *LC* {
		local beg=substr("`var'",1, 5)
		if "`beg'"!="total" {
			replace `var'=`var'/total_
		}
	}
	drop if ipums_id==. | ipums_id==888888 | ipums_id==888888888
	save "$projdir\data\Build\Africa\MODIS_LC\MODIS_`layer'.dta", replace
}


foreach w in 1 2 {
use "$projdir\data\Build\Africa\MODIS_LC\MODIS_LC_Prop2.dta", clear

foreach layer in $layers {
	if "`layer'"!="LC_Prop2"  {
		merge 1:1 ipums_id year using "$projdir\data\Build\Africa\MODIS_LC\MODIS_`layer'.dta", nogen 
	}
}

gen id_temp=ipums_id
tostring ipums_id, replace
replace ipums_id="0"+ipums_id if id_temp>72000 & id_temp<72100

*** This to get start and end years 

if `w'==1 {
	merge m:1 ipums_id using "${final}/forestloss.dta", nogen keep(match) keepusing(fl_*_yr Country)
}
else {
	merge m:1 ipums_id using "${final}/forestloss_period2.dta", nogen keep(match) keepusing(fl_*_yr Country)
}

tab Country

keep if year==fl_start_yr | year==fl_end_yr
sort ipums_id year



foreach var of varlist *LC* {
	gen bl_`var'=`var'[_n-1] if year==fl_end_yr
	gen delta_`var'=(`var'-`var'[_n-1])/(fl_end_yr-fl_start_yr) if year==fl_end_yr
	gen delta_log_`var'=log((`var'/`var'[_n-1])^(1/(fl_end_yr-fl_start_yr))) if year==fl_end_yr
}

compress
keep if year==fl_end_yr

drop *year
drop fl_*
save "${dropbox}\Migration Africa\data\Final\MODIS_LC_wide_`w'", replace
}


clear

append using "${final}\MODIS_LC_wide_1" "${final}\MODIS_LC_wide_2", gen(wave)

save "${final}\MODIS_LC_wide", replace